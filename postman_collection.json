                { "key": "idUsuarioCreacion", "value": "{{idUsuarioCreacion}}" }
              ]
            }
          }
        },
        {
          "name": "Actualizar registro",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "appToken", "value": "{{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"_id\": \"\",\n    \"monto\": 30000,\n    \"tipo\": \"Egreso\",\n    \"cuotas\": 3,\n    \"nCuotas\": 1,\n    \"facturacionInmediata\": false,\n    \"descripcion\": \"Compra actualizada\",\n    \"fechaCompra\": \"2026-10-16\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/credito/update",
              "host": ["{{baseUrl}}"],
              "path": ["credito", "update"]
            }
          },
          "response": [],
          "description": "El servidor rechaza con 403 si el registro ('_id') no pertenece al usuario dueño del token. La ruta ya no usa el parámetro :id (estaba sin uso)."
        },
        {
          "name": "Eliminar registro",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "appToken", "value": "{{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"identificador\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/credito/delete",
              "host": ["{{baseUrl}}"],
              "path": ["credito", "delete"]
            }
          },
          "response": [],
          "description": "Borra todas las cuotas que comparten 'identificador'. El servidor rechaza con 403 si no pertenecen al usuario dueño del token."
        }
      ]
    },
