              "host": ["{{baseUrl}}"],
              "path": ["credito"],
              "query": [
                { "key": "pagina", "value": "1" },
                { "key": "registrosPorPagina", "value": "10" },
                { "key": "mes", "value": "10" },
                { "key": "anio", "value": "2026" },
